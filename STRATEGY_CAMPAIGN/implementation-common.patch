+    def _reserve_paths(self):
+        # Same known floor only. The ordinary BFS contributes all existing safety restrictions.
+        a = self.agent
+        level = a.current_level()
+        start = (a.blstats.y, a.blstats.x)
+        safe = level.shop_interior & level.walkable & (a.bfs() >= 0) & (level.objects != -1)
+        safe &= ~utils.isin(level.objects, G.DOORS, G.TRAPS) & ~level.intact_doors
+        safe &= ~a.monster_tracker.monster_mask & ~utils.isin(a.glyphs, G.BOULDER)
+        if not safe[start]:
+            return {}
+        paths = {start: [start]}
+        queue = [start]
+        for y, x in queue:
+            path = paths[y, x]
+            if len(path) >= 3:
+                continue
+            for dy in (-1, 0, 1):
+                for dx in (-1, 0, 1):
+                    target = (y + dy, x + dx)
+                    ty, tx = target
+                    if target in paths or not (0 <= ty < safe.shape[0] and 0 <= tx < safe.shape[1]):
+                        continue
+                    if not safe[target]:
+                        continue
+                    # Conservatively forbid diagonal squeezing between blocked shop squares.
+                    if dy and dx and not (safe[y, tx] or safe[ty, x]):
+                        continue
+                    paths[target] = path + [target]
+                    queue.append(target)
+        return paths
