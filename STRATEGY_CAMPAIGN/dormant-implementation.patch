+        if not a.current_level().shop_interior[y, x]:
+            return None
+        if dis[y, x] == 0:
+            return [start]
+        if dis[y, x] == 1:
+            return [start, (y, x)]
+        for ny in range(max(0, start[0] - 1), min(dis.shape[0], start[0] + 2)):
+            for nx in range(max(0, start[1] - 1), min(dis.shape[1], start[1] + 2)):
+                if dis[ny, nx] == 1 and a.current_level().shop_interior[ny, nx] and \
+                        a.bfs(ny, nx)[y, x] == 1:
+                    return [start, (ny, nx), (y, x)]
+        return None
+
