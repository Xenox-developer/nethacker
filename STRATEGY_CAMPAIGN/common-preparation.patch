+def campaign_action_key(action):
+    if action[0] == 'zap':
+        return ('zap', action[1], action[2], id(action[3]))
+    return id(action)
+
+
+def campaign_alternate_choice(agent, actions):
+    # All downstream filters either retain zaps or filter only non-zap classes.
+    # Preserve original candidate order for max() ties, then append goto/moves.
+    original_ids = {id(a) for _, a in agent._campaign_original_actions}
+    retained_ids = {id(a) for _, a in actions}
+    shadow = [(s, a) for s, a in agent._campaign_alternate_actions
+              if a[0] == 'zap' or id(a) in retained_ids]
+    shadow.extend((s, a) for s, a in actions if id(a) not in original_ids)
+    return max(shadow, key=lambda pair: pair[0])[1] if shadow else None
